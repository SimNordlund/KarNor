# Server-only settings for the Kotlin/Spring backend.
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/karnor
DATABASE_USERNAME=
DATABASE_PASSWORD=
APP_URL=http://localhost:5173
ADMIN_PASSWORD=
# Shop products, orders and uploaded files are stored in the database above.
# Only read once: if the database is empty and this folder holds a store.json from the
# earlier file-based storage, it is imported (including files/) on first start.
KARNOR_DATA_DIR=./data
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Automatic delivery of purchased files. Verify the sending domain in Resend.
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
